# Chỉ placeholder — không commit giá trị thật.
# Kết nối Postgres phía server (Supabase: connection string "Transaction pooler"/direct). KHÔNG đưa xuống browser.
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/hoanhao_dev
# Supabase Auth: URL dự án + anon key (khóa công khai). KHÔNG đặt service role key ở đây.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Địa chỉ app dùng trong link đăng nhập gửi qua email (bắt buộc ở production)
APP_URL=http://localhost:3000
# Chế độ chọn danh tính demo — chỉ hoạt động khi NODE_ENV != production
DEV_IDENTITY_SWITCHER=1
